    "/api/logs": {
      "get": {
        "summary": "K10 kayıtlar: beş kaynak tek biçimde, süzgeçli ve sayfalı",
        "description": "Kaynaklar: requests (istek günlüğü), audit (denetim günlüğü), events (rafineri olayları), notifications (bildirimler), ticks (fiyat tick'leri). Satırlar zaman · kim · ne · sonuç olarak döner.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "name": "source",
            "in": "query",
            "description": "requests | audit | events | notifications | ticks"
          },
          {
            "schema": {
              "type": "string"
            },
            "name": "q",
            "in": "query",
            "description": "metin süzgeci"
          },
          {
            "schema": {
              "type": "string"
            },
            "name": "from",
            "in": "query",
            "description": "YYYY-AA-GG"
          },
          {
            "schema": {
              "type": "string"
            },
            "name": "to",
            "in": "query",
            "description": "YYYY-AA-GG"
          },
          {
            "schema": {
              "type": "string"
            },
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "name": "offset",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "{ items, total, source }",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/requests": {
      "get": {
        "summary": "K9 istek günlüğü (VARA kanıtı)",
        "description": "rafineriye giden ve gelen çağrılar; gövdenin kendisi değil sha256 özeti saklanır.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "name": "direction",
            "in": "query",
            "description": "GİDEN ya da GELEN"
          },
          {
            "schema": {
              "type": "string"
            },
            "name": "errors",
            "in": "query",
            "description": "1 ise yalnız hatalar"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/log-params": {
      "put": {
        "summary": "K9 istek günlüğü saklama parametreleri",
        "description": "Kritik aksiyon: onay numarası olmadan gelirse 202 ve onay numarası döner; ancak farklı bir kullanıcının onayıyla uygulanır (gövdeye approval_id ve approver eklenir). Aktör X-User başlığından okunur.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "retentionDays": {
                    "type": "string",
                    "description": "saklama süresi (gün)"
                  },
                  "maxRows": {
                    "type": "string",
                    "description": "satır tavanı"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "202": {
            "description": "ikinci onay bekleniyor (onay numarası döner)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
